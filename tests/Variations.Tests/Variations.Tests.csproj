<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SafeStbTrueTypeSharp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- TEST-ONLY independent shaping oracle for Part D (GSUB rvrn): HarfBuzz reads the twin's GSUB with its own code. src/ must never reference HarfBuzz. -->
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source variable fonts + fontTools-instanced static twins; provenance and per-position rationale in Fonts/FIXTURES.md.
         The generator (generate_instanced_fixtures.py) is checked in for the record but is NEVER run by the build. -->
    <None Update="Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Part B: the CFF2 source VF (AdobeVFPrototype.otf); its instanced twins are 'CFF ' fonts carrying the .ttf suffix. -->
    <None Update="Fonts\*.otf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts\FIXTURES.md" CopyToOutputDirectory="Never" />
    <None Update="Fonts\generate_instanced_fixtures.py" CopyToOutputDirectory="Never" />
    <!-- cmap edge-case fixtures (QuartzPdfSubset.*, Synthetic.Inter.*) ride the *.ttf glob above; generator is record-only. -->
    <None Update="Fonts\generate_cmap_fixtures.py" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>